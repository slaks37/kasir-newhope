    {
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>{const r=item.json; const job=$('Prepare Cover Jobs').itemMatching(index).json; if(r.ok!==true||r.coverGenerated!==true||!/^https:\\/\\//.test(r.coverImage||''))throw Error('Unique cover was not stored; publication stopped'); return {json:{mode:job.mode,article:{...job.article,coverImage:r.coverImage,coverAlt:r.coverAlt,coverGenerated:true},repairedSlug:r.repairedSlug||null},pairedItem:{item:index}};});"
      },
