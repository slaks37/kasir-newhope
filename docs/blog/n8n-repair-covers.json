      "name": "Load Covers to Repair",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        272,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jTYb0rFR3DFemQpo",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json; if(r.ok!==true||!Array.isArray(r.posts))throw Error('Could not load cover repair queue'); return r.posts.filter(p=>/\\/blog\\/covers\\/(hpp-ingredients|cash-reconciliation)-ai\\.jpg$/.test(p.coverImage||'')).map(p=>({json:{mode:'repair',article:p,expectedCover:p.coverImage}}));"
      },
      "id": "f32a8368-bb9b-40c7-8851-8fb1ecd4d8f9",
      "name": "Select Repeated Covers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const palettes = ['terracotta and cream','sage green and warm ivory','navy and pale peach','mustard and deep brown','teal and sand','burgundy and pearl'];\nconst scenes = ['overhead still life with ingredients arranged by unit cost and a kitchen scale','a small Indonesian food stall owner evaluating portions in a bright preparation kitchen','a boutique shop owner reviewing a simple visual sales chart among neatly arranged merchandise','a close-up of receipts grouped into three separate reconciliation trays','a split composition contrasting full order baskets with a small remaining profit jar','a ceramic plate with layered ingredient portions beside a measuring scoop','an isometric miniature shop with transparent blocks showing money flowing into cost categories','a bakery owner comparing two batches of bread and their ingredient baskets'];\nreturn $input.all().map((item,index)=>{\n const repair=item.json.mode==='repair';\n const a=repair?item.json.article:$('Parse Agnes - Validate VPC').first().json.article;\n if(!a?.title||!a?.excerpt)throw Error('Cover job lacks article context');\n const hash=Array.from(a.slug||a.title).reduce((n,c)=>(n*31+c.charCodeAt(0))>>>0,0);\n const title=a.title.toLowerCase();\n const cashScenes=['three distinct receipt trays being reconciled in a small shop at closing time','a shop owner comparing abstract payment records with a ledger on a bright wooden desk','three colored payment streams converging into a balanced reconciliation scale','an isometric shop with separate cash, contactless and bank-transfer lanes being matched'];\n const costScenes=['a chef weighing ingredients for a single plated meal in a clean preparation kitchen','an overhead arrangement of portioned Indonesian ingredients beside a kitchen scale','a bakery owner checking flour and butter quantities beside freshly baked bread','a market vendor measuring raw ingredients beside carefully portioned meal bowls'];\n const profitScenes=['a boutique owner comparing a full order basket against a small remaining profit jar','a miniature shop with transparent cost blocks and a visible remaining margin','a balancing scale comparing retail inventory costs with a symbolic sales basket','an overhead still life of product samples and grouped cost receipts'];\n const relevant=/rekonsiliasi|qris|tunai|transfer|selisih kas/.test(title)?cashScenes:/hpp|bahan|porsi|menu|f&b/.test(title)?costScenes:profitScenes;\n const scene=relevant[hash%relevant.length], palette=palettes[Math.floor(hash/relevant.length)%palettes.length];\n const prompt='Create a polished editorial illustration for an Indonesian small-business article. Topic: '+a.title+'. Context: '+a.excerpt+'. Interpret the specific topic faithfully using this distinct visual starting point: '+scene+'. Palette: '+palette+'. Warm natural light, tactile materials, sophisticated magazine art direction, clear focal subject, wide 16:9 composition, full bleed, no border. No headline, no captions, no legible numbers, no logos, no watermark. Avoid the generic cash-register/phone/banknotes-on-a-cafe-counter scene. This is a conceptual illustration, not a photograph of the event in the news. Each article needs its own visual interpretation.';\n return {json:{mode:repair?'repair':'publish',article:a,expectedCover:repair?item.json.expectedCover:undefined,prompt,alt:('Ilustrasi AI: '+a.title).slice(0,160)},pairedItem:{item:index}};\n});\n"
      },
