# ============================================================================
# Wajib diisi. Server SENGAJA MENOLAK MENYALA tanpa ketiganya — bukan karena
# rewel, melainkan karena nilai bawaan yang "aman" tidak ada. Rahasia yang
# dibangkitkan sendiri saat proses menyala berarti tiap replika menandatangani
# dengan kunci berbeda, dan tidak ada yang menyadari bahwa keamanannya
# bergantung pada nilai yang tidak pernah sengaja dipilih siapa pun.
# ============================================================================

DATABASE_URL=postgresql://user:pass@host:5432/nama

# Penanda tangan sesi konsol internal. Minimal 32 karakter.
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Penanda tangan token toko (aplikasi kasir). Minimal 32 karakter.
# WAJIB BERBEDA dari ADMIN_SESSION_SECRET — dengan begitu token kasir tidak
# pernah bisa dipakai sebagai token admin, atau sebaliknya.
#   openssl rand -base64 48
MERCHANT_SESSION_SECRET=

# Dikirim Vercel pada setiap pemanggilan terjadwal. Tanpa ini, alamat cron
# menjadi tombol publik untuk menjalankan proses berat berulang kali.
CRON_SECRET=

# ---------------------------------------------------------------------------
# TLS ke basis data
# ---------------------------------------------------------------------------
# Isi dengan sertifikat akar penyedia basis data Anda (isi berkas .crt-nya,
# termasuk baris BEGIN/END). Bila penyedia memakai akar publik yang sudah
# dipercaya Node, biarkan kosong — verifikasi tetap menyala.
DATABASE_CA_CERT=
# Darurat saja: menerima sertifikat tanpa memeriksanya. Setiap proses yang
# memakainya mencetak peringatan. Jangan dipakai di produksi.
# DATABASE_SSL_INSECURE=1

# ---------------------------------------------------------------------------
# Integrasi
# ---------------------------------------------------------------------------
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
DEEPSEEK_API_KEY=
RESEND_API_KEY=
BILLING_EMAIL_FROM=billing@newhopepos.id

# ---------------------------------------------------------------------------
# Skrip penyiapan (tidak dipakai aplikasi)
# ---------------------------------------------------------------------------
# scripts/db/create-superadmin.mjs menolak berjalan tanpa keduanya.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
