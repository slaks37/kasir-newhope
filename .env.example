# =============================================================================
# Salin berkas ini menjadi `.env` lalu isi nilainya. `.env` sudah masuk
# .gitignore dan tidak akan pernah ikut ter-commit.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# KOSONGKAN untuk pengembangan lokal. Tanpa nilai ini, `npm run dev` menyalakan
# PGlite sendiri dan tidak butuh apa pun dari luar.
#
# Diisi -> semua service terhubung ke PostgreSQL sungguhan lewat TLS.
#
# SUPABASE — ambil dari Dashboard > Project Settings > Database > Connection string
#
#   Pakai "Session pooler" (port 5432), BUKAN "Transaction pooler" (6543).
#   Transaction pooler tidak mempertahankan state sesi, sehingga `SET ROLE`
#   dan migrasi bertransaksi panjang bisa gagal dengan cara yang sulit
#   ditelusuri. Direct connection juga boleh, tapi Supabase kini
#   memberikannya lewat IPv6 saja — banyak jaringan rumah dan CI belum bisa.
#
#   Bentuknya:
#   DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
#   Ganti PASSWORD dengan Database Password proyek Anda (BUKAN anon key, BUKAN
#   service_role key — keduanya untuk PostgREST, bukan koneksi Postgres).
#   Lupa passwordnya? Reset di Dashboard > Project Settings > Database.
DATABASE_URL=""

# NEON STAGING: runtime uses the verified branch's -pooler hostname and a
# restricted application LOGIN. Auth uses its separate restricted LOGIN.
# This direct URL is migration-owner only; never expose it via VITE_ or runtime.
DATABASE_URL_UNPOOLED=""
# Generic remote migrate requires the reviewed project/branch, APP_ENV=staging
# and NEON_MIGRATION_CONFIRM=REVIEWED_STAGING_MIGRATIONS. It rejects populated
# imports with pending history. Use reviewed corrective scripts for restores.
# Never use db:apply (demo bootstrap); it deliberately rejects --live.

# Verifikasi sertifikat server. Kosong = koneksi tetap terenkripsi tapi
# identitas server tidak diverifikasi (cukup untuk pengembangan). Untuk
# produksi, unduh CA Supabase dari Dashboard > Project Settings > Database >
# SSL Configuration lalu isi jalurnya di sini.
PGSSLROOTCERT=""

# Jumlah koneksi per service. Supabase paket gratis punya batas rendah
# (±60 total, dibagi seluruh klien) — 4 x 5 service masih aman.
PGPOOL_MAX="4"

# Batas waktu satu query dalam milidetik (1000–120000, bawaan 8000). Harus di
# bawah timeout gateway (10 dtk) agar query yang ditinggal klien dibatalkan.
DB_STATEMENT_TIMEOUT_MS="8000"

# -----------------------------------------------------------------------------
# AI COPILOT (opsional)
# -----------------------------------------------------------------------------
# Tanpa kunci ini, Layer 1 dan Layer 2 tetap berjalan penuh dan gratis; hanya
# pertanyaan strategis terbuka yang nonaktif. API-nya OpenAI-compatible, jadi
# tidak butuh SDK tambahan.
#
# Pilihan 1: Agnes AI (rekomendasi efisiensi biaya)
AGNES_API_KEY=""
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_MODEL="agnes-latest"

# Pilihan 2: DeepSeek (fallback)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# -----------------------------------------------------------------------------
# SUPABASE AUTH (wajib untuk OAuth / login)
# -----------------------------------------------------------------------------
# Ambil dari Supabase Dashboard > Project Settings > API
#
#   VITE_SUPABASE_URL     = Project URL    (https://xxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon / public  (eyJhbGci...)
#
# Prefiks VITE_ WAJIB — tanpa itu Vite tidak mengirimnya ke browser.
# Dikosongkan saat pengembangan lokal: `npm run dev` lalu menjalankan
# services/dev-auth (Supabase Auth tiruan, KHUSUS lokal) dan mengisi keempat
# nilai SUPABASE secara otomatis. Jangan pernah dikosongkan di produksi.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# URL/key server-side untuk memverifikasi Bearer token ke Supabase Auth.
# Gunakan publishable/anon key, JANGAN service_role key.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Secret acak bersama gateway dan seluruh microservice. Wajib di produksi.
# `npm run dev` membuat nilai acak per sesi bila dikosongkan.
INTERNAL_GATEWAY_TOKEN=""

# Port auth lokal (services/dev-auth). Hanya dipakai saat SUPABASE_URL kosong.
# DEV_AUTH_PORT="54321"

# Pintas lama tanpa auth sama sekali. Tidak diperlukan lagi (pakai auth lokal);
# endpoint bisnis, laporan dan keuangan tetap menolak principal ini. Jangan
# pernah aktifkan di deployment — produksi fail-closed.
AUTH_ALLOW_LOCAL_DEVELOPMENT="0"

# Wajib untuk endpoint top-up kredit AI yang dipanggil oleh webhook pembayaran add-on.
AI_CREDIT_TOPUP_SECRET=""

# Shared secret dari penyedia pembayaran untuk webhook langganan generic.
PAYMENT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# DOKU PAYMENT GATEWAY (Subscription & POS Checkout)
# -----------------------------------------------------------------------------
# Dapatkan kredensial dari https://sandbox.doku.com (Sandbox) atau https://dashboard.doku.com (Prod)
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
# Harus PERSIS salah satu dari dua nilai ini; nilai lain ditolak (DOKU_API_URL_NOT_ALLOWED),
# tidak lagi dialihkan diam-diam ke produksi.
#   Sandbox    : https://api-sandbox.doku.com
#   Production : https://api.doku.com
DOKU_API_URL="https://api-sandbox.doku.com"
# Comma-separated exact channel.id values confirmed by DOKU for this account.
# Required for checkout/notification. Empty fails closed; do not guess channels.
DOKU_ALLOWED_CHANNELS=""
# Optional dedicated credentials used ONLY by the opt-in sandbox evidence tool
# (scripts/batch/doku-sandbox-evidence.ts). Never a fallback for checkout:
# checkout/webhook use DOKU_CLIENT_ID/DOKU_SECRET_KEY only.
DOKU_SANDBOX_CLIENT_ID=""
DOKU_SANDBOX_SECRET_KEY=""

# Wajib untuk seluruh Vercel Cron; tanpa ini endpoint cron menolak request.
CRON_SECRET=""
# Optional exact job allowlist (comma-separated). Unset runs every job; empty
# disables all. Vercel Cron (vercel.json) is the only scheduler — the GitHub
# workflow is manual-only.
CRON_ENABLED_JOBS="daily-insights"

# Opsional. Bila diisi, /api/admin/* dan /api/v1/blog* di Vercel diteruskan ke
# gateway mandiri ini (mis. https://api.newhopepos.id). Bila kosong, Vercel
# melayaninya sendiri (runtime native). Entry sync/billing/assistant selalu native.
GATEWAY_URL=""

# -----------------------------------------------------------------------------
# PORT (opsional — biarkan kosong untuk memakai bawaan)
# -----------------------------------------------------------------------------
# PORT_GATEWAY="3000"
# PORT_POS="3101"
# PORT_AI="3102"
# PORT_BILLING="3103"
# PORT_BACKOFFICE="3104"

# Nomor WhatsApp bisnis resmi dalam format internasional digit saja (tanpa +).
# Kosong: landing menampilkan panduan bantuan, bukan mengirim ke nomor contoh.
# Nilai ini publik di browser, bukan rahasia. Jangan isi dengan nomor dummy.
VITE_SUPPORT_WHATSAPP=""

# ── Blog & SEO ───────────────────────────────────────────────────────────────
# URL publik untuk canonical, sitemap, dan RSS blog (tanpa garis miring di akhir).
PUBLIC_SITE_URL="https://kasir.newhope.space"
# API key otomasi artikel (REST + MCP), dipisah koma; masing-masing minimal 24 karakter.
# Buat dengan: openssl rand -hex 32. Kosong = API otomasi menjawab 503.
BLOG_API_KEYS=""
