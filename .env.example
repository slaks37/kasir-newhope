# =============================================================================
# Salin berkas ini menjadi `.env` lalu isi nilainya. `.env` sudah masuk
# .gitignore dan tidak akan pernah ikut ter-commit.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# KOSONGKAN untuk pengembangan lokal. Tanpa nilai ini, `npm run dev` menyalakan
# PGlite sendiri dan tidak butuh apa pun dari luar.
#
# Diisi -> semua service terhubung ke PostgreSQL sungguhan lewat TLS.
#
# SUPABASE — ambil dari Dashboard > Project Settings > Database > Connection string
#
#   Pakai "Session pooler" (port 5432), BUKAN "Transaction pooler" (6543).
#   Transaction pooler tidak mempertahankan state sesi, sehingga `SET ROLE`
#   dan migrasi bertransaksi panjang bisa gagal dengan cara yang sulit
#   ditelusuri. Direct connection juga boleh, tapi Supabase kini
#   memberikannya lewat IPv6 saja — banyak jaringan rumah dan CI belum bisa.
#
#   Bentuknya:
#   DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
#   Ganti PASSWORD dengan Database Password proyek Anda (BUKAN anon key, BUKAN
#   service_role key — keduanya untuk PostgREST, bukan koneksi Postgres).
#   Lupa passwordnya? Reset di Dashboard > Project Settings > Database.
DATABASE_URL=""

# Verifikasi sertifikat server. Kosong = koneksi tetap terenkripsi tapi
# identitas server tidak diverifikasi (cukup untuk pengembangan). Untuk
# produksi, unduh CA Supabase dari Dashboard > Project Settings > Database >
# SSL Configuration lalu isi jalurnya di sini.
PGSSLROOTCERT=""

# Jumlah koneksi per service. Supabase paket gratis punya batas rendah
# (±60 total, dibagi seluruh klien) — 4 x 5 service masih aman.
PGPOOL_MAX="4"

# -----------------------------------------------------------------------------
# AI COPILOT (opsional)
# -----------------------------------------------------------------------------
# Tanpa kunci ini, Layer 1 dan Layer 2 tetap berjalan penuh dan gratis; hanya
# pertanyaan strategis terbuka yang nonaktif. API-nya OpenAI-compatible, jadi
# tidak butuh SDK tambahan.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# -----------------------------------------------------------------------------
# SUPABASE AUTH (wajib untuk OAuth / login)
# -----------------------------------------------------------------------------
# Ambil dari Supabase Dashboard > Project Settings > API
#
#   VITE_SUPABASE_URL     = Project URL    (https://xxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon / public  (eyJhbGci...)
#
# Prefiks VITE_ WAJIB — tanpa itu Vite tidak mengirimnya ke browser.
# Tanpa kedua nilai ini, halaman login tidak muncul dan app langsung masuk
# POS (mode pengembangan lokal).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# -----------------------------------------------------------------------------
# PORT (opsional — biarkan kosong untuk memakai bawaan)
# -----------------------------------------------------------------------------
# PORT_GATEWAY="3000"
# PORT_POS="3101"
# PORT_AI="3102"
# PORT_BILLING="3103"
# PORT_BACKOFFICE="3104"

# -----------------------------------------------------------------------------
# KONSOL INTERNAL (panel admin di /admin)
# -----------------------------------------------------------------------------
# Rahasia penanda tangan token sesi admin. WAJIB minimal 32 karakter.
# Tanpa ini login admin ditolak — sengaja gagal tertutup, karena panel ini bisa
# mengubah harga paket dan akses seluruh merchant.
#
# Bangkitkan satu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Password admin TIDAK disimpan di sini. Tetapkan lewat:
#   npm run admin:password -- email@anda.com --role ROLE_SUPERADMIN
ADMIN_SESSION_SECRET=""

# -----------------------------------------------------------------------------
# WEBHOOK PEMBAYARAN
# -----------------------------------------------------------------------------
# Rahasia bersama dengan payment gateway, dipakai memverifikasi HMAC-SHA256
# setiap webhook. WAJIB minimal 16 karakter.
#
# TANPA INI SEMUA WEBHOOK DITOLAK — sengaja gagal tertutup. Endpoint webhook
# adalah satu-satunya jalur yang boleh mengaktifkan langganan berbayar di
# produksi; tanpa penjagaan, siapa pun yang tahu URL-nya bisa mengirim
# `payment.succeeded` dan mendapat paket termahal tanpa uang berpindah.
#
# Bangkitkan satu, lalu daftarkan nilai yang sama di dashboard gateway:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Header yang diterima: x-signature, x-callback-signature, x-webhook-signature.
# Formatnya `t=<unix>,v1=<hex>` (disarankan — ada perlindungan kirim-ulang 5
# menit) atau hex polos.
PAYMENT_WEBHOOK_SECRET=""

# Membuka kembali simulate-payment dan top-up kredit gratis di produksi.
# BIARKAN KOSONG kecuali sedang menguji. Isi "1" berarti langganan berbayar
# bisa diaktifkan tanpa pembayaran.
# ALLOW_SIMULATED_PAYMENT=""

# -----------------------------------------------------------------------------
# DOKU — PEMBAYARAN LANGGANAN (QRIS lewat DOKU Checkout)
# -----------------------------------------------------------------------------
# Ambil dari dasbor DOKU: Settings -> API Keys.
#
#   Client ID       -> DOKU_CLIENT_ID   (bentuknya BRN-xxxx-xxxxxxxxxxxxx)
#   Active Secret   -> DOKU_SECRET_KEY  (bentuknya SK-xxxxxxxx)
#
# SECRET KEY TIDAK BOLEH MASUK REPOSITORI, tidak boleh dikirim lewat chat, dan
# tidak boleh ada di bundel front-end. Ia menandatangani permintaan atas nama
# akun Anda; siapa pun yang memilikinya bisa membuat tagihan sebagai Anda.
# Kalau pernah terlihat orang lain, tekan "Regenerate Secret Key" di dasbor.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""

# "production" untuk api.doku.com, selain itu sandbox (api-sandbox.doku.com).
# DITENTUKAN EKSPLISIT, bukan disimpulkan dari NODE_ENV — satu variabel yang
# lupa diset tidak boleh mengirim pembayaran sungguhan ke sandbox.
DOKU_ENV="sandbox"

# Path URL notifikasi, HARUS sama persis dengan Notification URL yang
# didaftarkan di dasbor DOKU. DOKU menandatangani notifikasi memakai path ini;
# salah nilai membuat SETIAP notifikasi sah ditolak, dan gejalanya terlihat
# seperti DOKU mengirim tanda tangan yang salah.
#
# Contoh: Notification URL https://toko-anda.com/api/v1/webhooks/doku
#         maka isinya      /api/v1/webhooks/doku
DOKU_NOTIFICATION_PATH="/api/v1/webhooks/doku"

# Alamat publik aplikasi, dipakai membangun callback_url yang dibuka pelanggan
# setelah selesai membayar. Kalau kosong, header Origin permintaan yang dipakai.
PUBLIC_BASE_URL=""
