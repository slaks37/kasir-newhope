{
  "crons": [
    {
      "path": "/api/cron/daily-insights",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/merchant-health",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/billing-reminders",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api|admin).*)",
      "destination": "/index.html"
    }
  ]
}
