{
  "crons": [
    {
      "path": "/api/cron/daily-insights",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/merchant-health",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/billing-reminders",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin\\.(.*)"
        }
      ],
      "destination": "/admin.html"
    },
    { "source": "/admin(.*)", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

