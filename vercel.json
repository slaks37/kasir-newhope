{
  "git": {
    "deploymentEnabled": {
      "codex/neon-auth-migration": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-insights",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/merchant-health",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/billing-reminders",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth/[...slug]?__path=/api/auth/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/api/v1/privacy/(.*)",
      "destination": "/api/v1/sync/[...slug]?__path=/api/v1/privacy/$1"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/blog-mcp",
      "destination": "/api/blog-mcp/resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/blog-mcp/oauth",
      "destination": "/api/blog-mcp/metadata"
    },
    {
      "source": "/api/blog-mcp/(.*)",
      "destination": "/api/blog-mcp/[...slug]?__path=/api/blog-mcp/$1"
    },
    {
      "source": "/api/blog-mcp",
      "destination": "/api/blog-mcp/[...slug]?__path=/api/blog-mcp"
    },
    {
      "source": "/api/v1/reports/(.*)",
      "destination": "/api/v1/sync/[...slug]?__path=/api/v1/reports/$1"
    },
    {
      "source": "/api/v1/finance/(.*)",
      "destination": "/api/v1/sync/[...slug]?__path=/api/v1/finance/$1"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp/resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp/resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp/metadata"
    },
    {
      "source": "/blog",
      "destination": "/api/admin/[...slug]?__path=/blog"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/api/admin/[...slug]?__path=/blog/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/admin/[...slug]?__path=/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/admin/[...slug]?__path=/rss.xml"
    },
    {
      "source": "/api/v1/blog-automation/(.*)",
      "destination": "/api/admin/[...slug]?__path=/api/v1/blog-automation/$1"
    },
    {
      "source": "/api/v1/blog-automation",
      "destination": "/api/admin/[...slug]?__path=/api/v1/blog-automation"
    },
    {
      "source": "/api/v1/blog/(.*)",
      "destination": "/api/admin/[...slug]?__path=/api/v1/blog/$1"
    },
    {
      "source": "/api/v1/blog",
      "destination": "/api/admin/[...slug]?__path=/api/v1/blog"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin/[...slug]?__path=/api/admin/$1"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin/[...slug]?__path=/api/admin"
    },
    {
      "source": "/api/v1/sync/(.*)",
      "destination": "/api/v1/sync/[...slug]?__path=/api/v1/sync/$1"
    },
    {
      "source": "/api/v1/sync",
      "destination": "/api/v1/sync/[...slug]?__path=/api/v1/sync"
    },
    {
      "source": "/api/v1/subscription/(.*)",
      "destination": "/api/v1/subscription/[...slug]?__path=/api/v1/subscription/$1"
    },
    {
      "source": "/api/v1/subscription",
      "destination": "/api/v1/subscription/[...slug]?__path=/api/v1/subscription"
    },
    {
      "source": "/api/v1/assistant/(.*)",
      "destination": "/api/v1/assistant/[...slug]?__path=/api/v1/assistant/$1"
    },
    {
      "source": "/api/v1/assistant",
      "destination": "/api/v1/assistant/[...slug]?__path=/api/v1/assistant"
    },
    {
      "source": "/api/mcp/(.*)",
      "destination": "/api/mcp/[...slug]?__path=/api/mcp/$1"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/mcp/[...slug]?__path=/api/mcp"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api|admin|google|\\.well-known|.*\\.(?:txt|json|xml|ico|svg|png|jpg|jpeg|webp|webmanifest)$).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/reset-password",
      "headers": [
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Cache-Control", "value": "private, no-store"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/api/auth/(.*)",
      "headers": [
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Cache-Control", "value": "private, no-store"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/ai-catalog.json>; rel=\"ai-catalog\", </.well-known/ard.json>; rel=\"ard\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
