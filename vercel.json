{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin\\.(.*)"
        }
      ],
      "destination": "/admin.html"
    },
    { "source": "/admin(.*)", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/harian", "schedule": "0 19 * * *" },
    { "path": "/api/cron/kredit-menggantung", "schedule": "*/15 * * * *" }
  ]
}
