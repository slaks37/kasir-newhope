{
  "name": "new-hope-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node services/dev.mjs",
    "build": "vite build && esbuild services/gateway/index.ts services/pos/index.ts services/ai/index.ts services/billing/index.ts services/backoffice/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist/services",
    "start": "node dist/services/gateway/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run hygiene && npm run typecheck && vitest run",
    "hygiene": "node scripts/dev/check-source-hygiene.mjs",
    "smoke": "tsx scripts/dev/smoke-assistant.ts",
    "batch:insights": "node scripts/batch/daily-insights.mjs",
    "batch:insights:dry": "node scripts/batch/daily-insights.mjs --dry-run",
    "batch:health": "node scripts/batch/merchant-health.mjs",
    "batch:health:dry": "node scripts/batch/merchant-health.mjs --dry-run",
    "batch:billing": "node scripts/batch/billing-reminders.mjs",
    "db:verify": "node scripts/db/bootstrap.mjs",
    "db:apply": "node scripts/db/bootstrap.mjs --live",
    "db:seed": "tsx scripts/db/seed.ts",
    "admin:password": "tsx scripts/db/set-admin-password.mjs",
    "db:reseed": "tsx scripts/db/seed.ts --force",
    "db:reset": "node -e \"require('fs').rmSync('.pgdata',{recursive:true,force:true})\" && tsx scripts/db/seed.ts",
    "services": "node services/dev.mjs",
    "db:server": "tsx services/db-server/index.ts",
    "db:migrate": "tsx services/db-server/migrate.ts",
    "start:pos": "node dist/services/pos/index.js",
    "start:ai": "node dist/services/ai/index.js",
    "start:billing": "node dist/services/billing/index.js",
    "start:backoffice": "node dist/services/backoffice/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite-socket": "^0.2.8",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "4.1.11"
  }
}
